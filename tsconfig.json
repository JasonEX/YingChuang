{
  "compilerOptions": {
    "rootDir": "src",
    "sourceMap": false, // allow sourcemap support
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "esnext", // specifiy module code generation
    "jsx": "preserve", // preserve JSX for Vue JSX support
    "target": "es2020", // specify ECMAScript target version
    "lib": ["es2020", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true, // allow a partial TypeScript and JavaScript codebase
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vue"] // include Vue type definitions
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue", // include Vue single-file components
    "src/**/*.d.ts"
  ]
}
